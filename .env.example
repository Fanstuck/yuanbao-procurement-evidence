# Real-time mode: paste a service API KEY into your own .env; never commit it.
# Alternatively, export the existing yuanbao_search environment variable.
YUANBAO_API_KEY=
# Optional application access password for non-local deployment.
APP_ACCESS_TOKEN=
# true respects HTTP_PROXY / HTTPS_PROXY. Use false only if direct access is intended.
USE_ENV_PROXY=true
